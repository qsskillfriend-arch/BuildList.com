# ═══════════════════════════════════════════════════
# BUILDLIST — .gitignore
# ═══════════════════════════════════════════════════

# ── Operating System ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Editor / IDE ────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Node (for when you add a backend later) ─────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
.npm

# ── Environment & Secrets — NEVER commit these ──────
.env
.env.local
.env.development
.env.production
.env.staging
*.pem
*.key
secrets.json

# ── Build output ────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/

# ── Netlify ─────────────────────────────────────────
.netlify/

# ── Logs ────────────────────────────────────────────
logs/
*.log

# ── Temporary files ─────────────────────────────────
tmp/
temp/
*.tmp
*.bak

# ── Screenshots (dev only, don't bloat the repo) ────
ss_*.png
screenshot-*.png


# ── Stage 3 ──────────────────────────────────────────
# Never commit the service_role key or a populated env file.
.env
.env.*
supabase/.temp/

# ── Stage 5 generated pages ──────────────────────────
# Rebuilt by build.js on every deploy. Committing them creates noisy
# diffs and lets the repo drift from the data.
/firms/
/browse/
/tenders/
/news/

supabase/.env
