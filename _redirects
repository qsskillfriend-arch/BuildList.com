# BuildList.com — Netlify redirects
# Vercel reads vercel.json instead; both are kept so this repository
# deploys to either host unchanged.

# ── Form endpoint ────────────────────────────────────
# Same public path as Vercel, so the browser never needs to know which
# platform it is on.
/api/form                /.netlify/functions/form   200

# ── Never served ─────────────────────────────────────
# admin.html is protected only by a passphrase in its own source, which
# is not security. supabase/ must ship because the build runs pull.js,
# but nothing in it should be readable over the web.
/admin.html              /404.html                  404!
/supabase/*              /404.html                  404!
/lib/*                   /404.html                  404!
/netlify/*               /404.html                  404!

# ── Clean URLs ───────────────────────────────────────
/directory               /browse/                   301
/tenders                 /#/tenders                 301
/jobs                    /#/jobs                    301
/news                    /#/news                    301
/prices                  /#/news                    301
/events                  /#/news                    301
/advertise               /#/advertise               301
/submit                  /#/submit                  301
/add-listing             /#/submit                  301
/about                   /#/about                   301
/contact                 /#/about                   301
/privacy                 /#/privacy                 301
/privacy-policy          /#/privacy                 301
/terms                   /#/terms                   301
/media-kit               /downloads/BuildList-Media-Kit.pdf  302

